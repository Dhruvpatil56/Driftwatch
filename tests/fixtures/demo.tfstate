{
  "version": 4,
  "terraform_version": "1.7.0",
  "serial": 1,
  "lineage": "driftwatch-test-fixture",
  "outputs": {},
  "_comment": "Checked-in test fixture. IDs are fake but valid-format and machine-independent. Never put real AWS IDs here. Mirrors terraform-demo/actual-state.demo.json so offline detection produces predictable drift.",
  "resources": [
    {
      "mode": "managed",
      "type": "aws_instance",
      "name": "web",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "i-0demo0web00000001",
            "ami": "ami-0abcdef1234567890",
            "instance_type": "t3.micro",
            "tags": {
              "Name": "driftwatch-web",
              "Environment": "demo"
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_security_group",
      "name": "web_sg",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "sg-0demo0websg000001",
            "name": "driftwatch-web-sg",
            "description": "DriftWatch demo security group",
            "ingress": [
              {
                "from_port": 443,
                "to_port": 443,
                "protocol": "tcp",
                "cidr_blocks": ["0.0.0.0/0"]
              }
            ],
            "egress": [
              {
                "from_port": 0,
                "to_port": 0,
                "protocol": "-1",
                "cidr_blocks": ["0.0.0.0/0"]
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "data",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "driftwatch-demo-data",
            "bucket": "driftwatch-demo-data",
            "tags": {
              "Name": "driftwatch-demo-data"
            }
          }
        }
      ]
    }
  ]
}
