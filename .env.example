# Copy to .env and adjust. docker compose reads this file.

# --- Postgres ---
POSTGRES_USER=driftwatch
POSTGRES_PASSWORD=driftwatch
POSTGRES_DB=driftwatch
# Inside docker the host is the service name "postgres"; for local dev use localhost.
DATABASE_URL=postgresql+psycopg2://driftwatch:driftwatch@postgres:5432/driftwatch

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 1 = use the committed demo fixture instead of live AWS (zero-config startup).
# Set to 0 and provide credentials above to reconcile against real AWS.
DRIFTWATCH_OFFLINE=1

# --- API ---
CORS_ORIGINS=http://localhost:3000
SCRAPE_INTERVAL_MINUTES=2

# --- OPA policy engine (Sprint 5) ---
# The scorer evaluates policies/rules.rego via this OPA sidecar. If unset or
# unreachable, scoring falls back to the built-in Python rules.
OPA_URL=http://opa:8181

# --- Redis (Sprint 5) ---
# Used to cache Groq drift explanations. If unreachable, caching is skipped.
REDIS_URL=redis://redis:6379/0

# --- Groq AI explanations (Sprint 5, OPTIONAL) ---
# Plain-English drift explanations. AI touches explanation ONLY — never
# detection, scoring, or remediation. If GROQ_API_KEY is blank, a deterministic
# local fallback explanation is used instead (no API call).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Slack alerting (Sprint 5, OPTIONAL) ---
# New Critical/High drift is posted to this incoming webhook. If blank, Slack
# alerting is skipped silently (never errors).
SLACK_WEBHOOK_URL=

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@driftwatch.local
PGADMIN_DEFAULT_PASSWORD=admin

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Frontend (Sprint 3) ---
VITE_API_URL=http://localhost:8000/api
